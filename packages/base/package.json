{
  "name": "@whale/base",
  "version": "0.1.0",
  "description": "Whale design system base components",
  "type": "module",
  "packageManager": "yarn@4.5.0",
  "sideEffects": [
    "**/*.css.ts",
    "**/*.css"
  ],
  "exports": {
    ".": {
      "development": "./src/mod.ts",
      "types": "./dist/mod.d.ts",
      "import": "./dist/mod.js",
      "require": "./dist/mod.cjs"
    }
  },
  "main": "./dist/mod.cjs",
  "module": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "extract:component": "tsx ../../scripts/extract-component/command.mts --name Button --node 17:138",
    "lint": "eslint \"**/*.{ts,tsx}\" --fix"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "radix-ui": "^1.4.3"
  },
  "peerDependencies": {
    "@whale/foundation": "^1.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vanilla-extract/css": "^1.15.5",
    "@vanilla-extract/esbuild-plugin": "^2.3.9",
    "@vanilla-extract/recipes": "^0.5.6",
    "fs-extra": "^11.0.0",
    "tsup": "^8.3.0",
    "tsx": "^3.12.7"
  }
}
