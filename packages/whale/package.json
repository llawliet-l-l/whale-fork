{
  "name": "@arthur2079/whale3",
  "version": "0.1.1-next.0",
  "description": "Whale design system — Radix Themes and custom components for React 18 & 19",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "typesVersions": {
    "*": {
      "styles.css": [
        "./dist/styles.css.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "rangutopia library build && node scripts/use-client.mjs && node scripts/build-styles.mjs",
    "dev": "tsc -p ./tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@radix-ui/themes": "3.3.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.1",
    "esbuild-plugins-node-modules-polyfill": "^1.7.1",
    "rangutopia": "^0.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rango-exchange/whale.git"
  },
  "stableVersion": "0.1.0"
}
