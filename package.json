{
  "name": "whale",
  "packageManager": "yarn@4.5.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @whale/storybook dev",
    "build:storybook": "yarn workspace @whale/storybook build",
    "build:foundation": "yarn workspace @whale/foundation build",
    "build:base": "yarn workspace @whale/base build",
    "build": "yarn build:foundation && yarn build:storybook",
    "postinstall": "husky",
    "lint": "yarn workspaces foreach -A run lint",
    "g:build": "esbuild --outdir=dist --bundle",
    "commitlint": "commitlint --edit",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/compat": "^1.2.2",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.14.0",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/types": "^8.6.14",
    "@types/command-line-args": "^5.2.3",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "command-line-args": "^6.0.1",
    "dotenv": "^16.4.5",
    "esbuild": "^0.24.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-rango": "^0.0.1",
    "eslint-plugin-destructuring": "^2.2.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-id-attribute-enforcement": "^1.0.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "fs-extra": "^11.3.1",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "nodemon": "^3.1.10",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.6.14",
    "style-dictionary": "^4.1.4",
    "style-dictionary-utils": "^4.0.5",
    "tsx": "^4.20.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
